{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Raccolta Quiz Simulator v2",
  "type": "object",
  "required": ["versione_schema", "id", "titolo", "domande"],
  "additionalProperties": false,
  "properties": {
    "versione_schema": {"const": 2},
    "id": {"type": "string", "minLength": 1, "maxLength": 200},
    "titolo": {"type": "string", "minLength": 1},
    "domande": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/domanda"}}
  },
  "$defs": {
    "domanda": {
      "type": "object",
      "required": ["id", "tipo", "testo"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 200},
        "tipo": {"enum": ["scelta_singola", "scelta_multipla", "aperta_breve", "aperta_libera"]},
        "testo": {"type": "string", "minLength": 1},
        "argomento": {"type": "string"},
        "spiegazione": {"type": "string"},
        "risposte": {"type": "array", "minItems": 2, "items": {
          "type": "object", "required": ["id", "testo"], "additionalProperties": false,
          "properties": {"id": {"type": "string", "minLength": 1}, "testo": {"type": "string", "minLength": 1}}
        }},
        "corrette": {"type": "array", "uniqueItems": true, "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "risposte_ammesse": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "risposta_modello": {"type": "string", "minLength": 1},
        "criteri": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      },
      "allOf": [
        {"if": {"properties": {"tipo": {"const": "scelta_singola"}}}, "then": {"required": ["risposte", "corrette"], "properties": {"corrette": {"maxItems": 1}}}},
        {"if": {"properties": {"tipo": {"const": "scelta_multipla"}}}, "then": {"required": ["risposte", "corrette"], "properties": {"corrette": {"minItems": 2}}}},
        {"if": {"properties": {"tipo": {"const": "aperta_breve"}}}, "then": {"required": ["risposte_ammesse"]}},
        {"if": {"properties": {"tipo": {"const": "aperta_libera"}}}, "then": {"required": ["risposta_modello", "criteri"]}}
      ]
    }
  }
}
